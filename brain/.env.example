# Seekr Brain — environment. Copy to brain/.env (or use the repo-root .env);
# both are gitignored. Never commit real values.

# Memories.ai (persistent visual memory). Get a key at https://memories.ai/app/service/key
MEMORIES_API_KEY=
# MEMORIES_COLLECTION_ID=      # optional: reuse an existing Datalake collection
# MEMORIES_COLLECTION_NAME=seekr-worlds-memories

# Liquid AI perception (defaults shown)
# LIQUID_MODEL_ID=LiquidAI/LFM2.5-VL-3B
# LIQUID_MAX_NEW_TOKENS=160

# Server
# ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# MAX_IMAGE_BYTES=4000000
# HF_TOKEN=            # only if your Hugging Face cache/download requires it

# Nimble Search API v2 (Discover tab). https://docs.nimbleway.com
NIMBLE_API_KEY=

# Black Forest Labs FLUX.2 [pro] (memory postcards). https://docs.bfl.ai
BFL_API_KEY=
