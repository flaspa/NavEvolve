# NavEvolve Brain — environment. Copy to brain/.env (gitignored) and fill in.
# Never commit real values. These are read ONLY by the Python server.

# MongoDB Atlas (hackathon sandbox). Atlas ▸ Connect ▸ Drivers ▸ Python.
MONGODB_URI=
MONGODB_DB=navevolve

# Server
# ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Gemini perception (perception.py). Key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_VLM_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIM=768
